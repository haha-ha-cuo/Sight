## RSS 原型无需数据库。密钥留空时可使用订阅摘要和示例预览。
SIGHT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
SIGHT_MODEL=deepseek-flash

## 如需百炼，设置 SIGHT_PROVIDER=dashscope、SIGHT_MODEL=qwen-plus。
DASHSCOPE_API_KEY=

## 以下仅供已有的数据库健康检查接口使用。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=sight
