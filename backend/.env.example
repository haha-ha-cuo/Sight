## 模型密钥留空时仍可使用 RSS 订阅摘要和示例预览。
SIGHT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
SIGHT_MODEL=deepseek-flash

## 如需百炼，设置 SIGHT_PROVIDER=dashscope、SIGHT_MODEL=qwen-plus。
DASHSCOPE_API_KEY=

## 用户、Agent、对话、订阅及阅读记录使用此数据库。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sight

## 可选：固定会话签名密钥。留空时自动生成至 instance/session.key。
SIGHT_SECRET_KEY=
